                                <option value="sanitario">Sanitario (Ambulanza, Assistenza eventi, Primo Soccorso)</option>
                                <option value="sociale">Sociale (Supporto popolazione fragile, Distribuzione beni)</option>
                                <option value="indeciso">Tutti i settori / Vorrei maggiori informazioni</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-semibold text-secondary">Breve presentazione o note (Opzionale)</label>
